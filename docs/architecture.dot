digraph G {
  rankdir=LR; fontname="Helvetica"; node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#E8F1FB", color="#2F6DB5"]; edge [fontname="Helvetica", fontsize=9];
  sim [label="Vehicle / device\n(simulator.py or\ndevice_mqtt.py with X.509)\ntyre x4, pedals, fuel", fillcolor="#FFF4D6", color="#C58B00"];
  iot [label="AWS IoT Core\nvehicles/<id>/telemetry\n(per-device policy)"];
  r1 [label="Rule 1\nhistory", shape=ellipse]; r2 [label="Rule 2\nlow tyre < 28 psi", shape=ellipse]; r3 [label="Rule 3\nlatest state", shape=ellipse];
  fh [label="Firehose (60 s buffer)\n+ Lambda: validate,\nnormalise, keep extras"]; raw [label="S3 raw/\n(original messages)"]; s3 [label="S3 telemetry/\ncurated JSON, dt/hr"]; err [label="S3 errors/", fillcolor="#FDE7E7", color="#BB3333"];
  glue [label="Glue table"]; ath [label="Athena SQL"];
  sns [label="SNS email\n(driver / support)", fillcolor="#FDE7E7", color="#BB3333"]; ddb [label="DynamoDB\nlatest state", fillcolor="#E6F6E6", color="#2E8B2E"];
  bot [label="chatbot.py\nfixed safe queries + LLM", fillcolor="#F0E6FA", color="#7A3FB5"]; user [label="Driver /\nsupport team", shape=oval, fillcolor="#FFFFFF"];
  cw [label="CloudWatch\ndashboard, 6 alarms, logs", fillcolor="#FFF0E0", color="#CC6600"]; ops [label="Ops email\n(alarms)", shape=oval, fillcolor="#FFFFFF"];
  sim -> iot [label="MQTT/TLS"]; iot -> r1; iot -> r2; iot -> r3;
  r1 -> fh; fh -> s3 [label="ok"]; fh -> raw [label="backup"]; fh -> err [label="rejected", style=dashed];
  s3 -> glue [style=dashed]; glue -> ath; s3 -> ath;
  r2 -> sns; sns -> user; r3 -> ddb; ddb -> user; ath -> bot; bot -> user;
  iot -> cw [style=dotted]; fh -> cw [style=dotted]; cw -> ops [label="alarms"];
}
